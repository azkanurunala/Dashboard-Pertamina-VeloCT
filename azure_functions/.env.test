# Using pei-dashboard database
AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=tcp:pei-dashboard.database.windows.net,1433;Database=pei-dashboard;Uid=CloudSAa33fbc7c;Pwd=uRahcie3&105272;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Test SQL Server Connection String (same as production for now)
TEST_SQL_SERVER_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=tcp:pei-dashboard.database.windows.net,1433;Database=pei-dashboard;Uid=CloudSAa33fbc7c;Pwd=uRahcie3&105272;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Local SQL Server Database Configuration (fallback - not used)
LOCAL_SQL_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=NewsScrapingTestDB;Trusted_Connection=yes;"

# Database Configuration
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30
DB_COMMAND_TIMEOUT=60
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=2

# Test Configuration
USE_MOCK_DATABASE=false
TEST_DATABASE_NAME=pei-dashboard

# Azure Services Configuration (for future use)
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
APPINSIGHTS_INSTRUMENTATIONKEY=your-appinsights-key
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# Copilot Configuration (for future use)
COPILOT_API_ENDPOINT=https://api.openai.com/v1
COPILOT_MODEL_NAME=gpt-4
COPILOT_MAX_TOKENS=4000
COPILOT_TEMPERATURE=0.3
COPILOT_RATE_LIMIT=60
COPILOT_BATCH_SIZE=10

# Scraper Configuration
SCRAPER_RATE_LIMIT_DELAY=1
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30
SCRAPER_USE_SELENIUM=false