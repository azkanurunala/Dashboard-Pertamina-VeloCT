# ─── AI Provider ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
AI_TYPE=OPENAI
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o

# ─── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS='{...service account JSON...}'
SPREADSHEET_ID=
SPREADSHEET_ID_STRUCTURE=

# ─── Microsoft / OneDrive ─────────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_USER_EMAIL=

# OneDrive file paths (used when STORAGE_BACKEND=onedrive)
ONEDRIVE_FILE_PATH=/results/(News)Scrapping.xlsx
ONEDRIVE_SENTIMENT_PATH=/results/(News)Sentiment.xlsx
ONEDRIVE_DATA_PATH=/results/(Terstruktur)Data Scrapping.xlsx

# ─── Storage Backend Switch ────────────────────────────────────────────────────
# "onedrive" = read/write Excel files via MS Graph API (default, local dev)
# "neon"     = read/write PostgreSQL via Neon (production / GitHub Actions)
STORAGE_BACKEND=onedrive

# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Get from Neon console: Project → Connection Details → Connection string
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
NEON_DB_URL=
