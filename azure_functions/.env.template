# Azure Functions Environment Configuration
# Copy this to .env and fill in your actual values

# Azure Storage Account
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key

# Azure Key Vault
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_TENANT_ID=your_tenant_id

# SQL Server Database
SQL_SERVER_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=your_server.database.windows.net;Database=your_database;Uid=your_username;Pwd=your_password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# AI Provider — pick one via AI_TYPE: GEMINI | OPENAI | AZURE_OPENAI | CLAUDE | DEEPSEEK | GROQ
# Then set the matching {TYPE}_API_KEY. Other providers' keys are ignored.
AI_TYPE=AZURE_OPENAI
GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL_NAME=gemini-2.0-flash              # optional
# GEMINI_API_ENDPOINT=                            # optional (built from model name)
# OPENAI_API_KEY=sk-...                           # only if AI_TYPE=OPENAI
# OPENAI_MODEL_NAME=gpt-4o-mini                   # optional
# AZURE_OPENAI_API_KEY=...                        # only if AI_TYPE=AZURE_OPENAI
# AZURE_OPENAI_MODEL_NAME=gpt-5.4-mini            # optional (deployment name)
# AZURE_OPENAI_API_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-12-01-preview
# CLAUDE_API_KEY=sk-ant-...                       # only if AI_TYPE=CLAUDE
# CLAUDE_MODEL_NAME=claude-3-5-sonnet-20241022    # optional
# DEEPSEEK_API_KEY=...                            # only if AI_TYPE=DEEPSEEK
# GROQ_API_KEY=...                                # only if AI_TYPE=GROQ
# Shared tuning params (apply regardless of provider)
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.3
AI_RATE_LIMIT=60
AI_BATCH_SIZE=10

# Testing Configuration
TEST_MODE=true
USE_MOCK_SERVICES=true

# Timer Schedules (CRON expressions)
MORNING_TIMER_SCHEDULE="0 0 6 * * *"
AFTERNOON_TIMER_SCHEDULE="0 0 14 * * *"
WEEKLY_TIMER_SCHEDULE="0 0 8 * * 0"
MONTHLY_TIMER_SCHEDULE="0 0 9 1 * *"