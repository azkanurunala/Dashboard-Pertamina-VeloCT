# CSV Data Seeding Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Database Configuration
# ============================================================================

# Option 1: Provide full connection string
# SQL_SERVER_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server.database.windows.net;DATABASE=your-database;UID=your-username;PWD=your-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Option 2: Provide individual database components (will be combined into connection string)
DB_SERVER=your-server.database.windows.net
DB_NAME=your-database
DB_USER=your-username
DB_PASSWORD=your-password
DB_DRIVER=ODBC Driver 18 for SQL Server

# ============================================================================
# Application Configuration
# ============================================================================

# Batch size for database inserts (default: 100)
BATCH_SIZE=100

# Dry run mode - validate data without inserting into database (default: false)
# Set to "true", "1", or "yes" to enable
DRY_RUN=false

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# ============================================================================
# Directory Configuration
# ============================================================================

# Directory containing news CSV files (default: references/news)
NEWS_DIRECTORY=references/news

# Directory containing sentiment CSV files (default: references/sentiment)
SENTIMENT_DIRECTORY=references/sentiment

# ============================================================================
# Logging Configuration
# ============================================================================

# Path to log file (default: logs/csv_seeding.log)
LOG_FILE=logs/csv_seeding.log
